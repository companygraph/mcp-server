{
  "name": "companygraph-mcp-server",
  "version": "0.61.0",
  "description": "A read-only MCP server for any CompanyGraph instance",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "bin",
    "deploy",
    "types/lib",
    "types/deploy"
  ],
  "bin": {
    "companygraph-mcp": "bin/stdio.mjs",
    "companygraph-mcp-snapshot": "bin/snapshot.mjs",
    "companygraph-mcp-http": "bin/http.mjs",
    "companygraph-mcp-deploy": "bin/deploy.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/lib/server.d.mts",
      "default": "./lib/server.mjs"
    },
    "./model": {
      "types": "./types/lib/model.d.mts",
      "default": "./lib/model.mjs"
    },
    "./schemas": {
      "types": "./types/lib/schemas.d.mts",
      "default": "./lib/schemas.mjs"
    },
    "./errors": {
      "types": "./types/lib/errors.d.mts",
      "default": "./lib/errors.mjs"
    },
    "./diagram": {
      "types": "./types/lib/diagram.d.mts",
      "default": "./lib/diagram.mjs"
    },
    "./contract": {
      "types": "./types/lib/contract.d.mts",
      "default": "./lib/contract.mjs"
    },
    "./snapshot": {
      "types": "./types/lib/snapshot.d.mts",
      "default": "./lib/snapshot.mjs"
    },
    "./read": {
      "types": "./types/lib/read.d.mts",
      "default": "./lib/read.mjs"
    },
    "./http": {
      "types": "./types/lib/http.d.mts",
      "default": "./lib/http.mjs"
    },
    "./deploy": {
      "types": "./types/deploy/build/index.d.mts",
      "default": "./deploy/build/index.mjs"
    },
    "./deploy/tests": {
      "types": "./types/deploy/test/index.d.mts",
      "default": "./deploy/test/index.mjs"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:check": "node tools/build-check.mjs",
    "typecheck": "tsc --noEmit",
    "fixtures": "node scripts/fixtures.mjs",
    "pretest": "node scripts/fixtures.mjs",
    "test": "node --test 'test/*.test.mjs'",
    "interface": "node scripts/interface.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "companygraph-meta-model": "github:companygraph/meta-model#v0.88.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "22.20.5",
    "playwright": "^1.63.0",
    "typescript": "7.0.2"
  }
}
